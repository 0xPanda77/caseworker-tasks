{% extends "template.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% set pageTitle = "Tasks" %}

{# Nunjucks has no "append to list", so push then re-assign. #}
{% set rows = [] %}
{% for task in tasks %}
  {% set dueHtml %}
    {{ task.dueAt | formatDateTime }}
    {% if task.overdue %}
      {{ govukTag({ text: "Overdue", classes: "govuk-tag--red" }) }}
    {% endif %}
  {% endset %}
  {% set viewHtml %}
    <a href="/tasks/{{ task.id }}" class="govuk-link">View<span class="govuk-visually-hidden"> {{ task.title }}</span></a>
  {% endset %}
  {% set rows = (rows.push([
    { text: task.title },
    { html: govukTag({ text: task.status | statusLabel, classes: task.status | statusTagClass }) },
    { html: dueHtml },
    { html: viewHtml }
  ]), rows) %}
{% endfor %}

{% block content %}
  {% if deleted %}
    {{ govukNotificationBanner({ type: "success", text: "Task deleted" }) }}
  {% endif %}

  <h1 class="govuk-heading-l">Tasks</h1>

  {{ govukButton({ text: "Create a task", href: "/tasks/new" }) }}

  {% if tasks.length %}
    {{ govukTable({
      caption: "All tasks, earliest due first",
      captionClasses: "govuk-visually-hidden",
      head: [
        { text: "Title" },
        { text: "Status" },
        { text: "Due" },
        { html: '<span class="govuk-visually-hidden">Actions</span>' }
      ],
      rows: rows
    }) }}
  {% else %}
    <p class="govuk-body">There are no tasks yet.</p>
  {% endif %}
{% endblock %}
