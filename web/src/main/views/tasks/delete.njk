{% extends "template.njk" %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}

{% set pageTitle = "Are you sure you want to delete this task?" %}

{% block beforeContent %}
  {{ govukBackLink({ text: "Back", href: "/tasks/" + task.id }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">{{ task.title }}</span>
      <h1 class="govuk-heading-l">Are you sure you want to delete this task?</h1>

      {{ govukWarningText({ text: "You cannot undo this." }) }}

      {# A plain form POST, so deleting works without JavaScript. #}
      <form method="post" action="/tasks/{{ task.id }}/delete" novalidate>
        <div class="govuk-button-group">
          {{ govukButton({ text: "Yes, delete task", classes: "govuk-button--warning" }) }}
          <a href="/tasks/{{ task.id }}" class="govuk-link">No, go back</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}
