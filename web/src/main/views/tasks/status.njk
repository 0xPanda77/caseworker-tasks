{% extends "template.njk" %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}

{% set pageTitle = "Change status" %}
{% set errors = errorMessages or {} %}

{% block beforeContent %}
  {{ govukBackLink({ text: "Back", href: "/tasks/" + task.id }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorList and errorList.length %}
        {{ govukErrorSummary({ titleText: "There is a problem", errorList: errorList }) }}
      {% endif %}

      <form method="post" action="/tasks/{{ task.id }}/status" novalidate>
        <span class="govuk-caption-l">{{ task.title }}</span>
        {{ govukRadios({
          name: "status",
          fieldset: {
            legend: { text: "Change status", isPageHeading: true, classes: "govuk-fieldset__legend--l" }
          },
          value: status,
          errorMessage: { text: errors.status } if errors.status else false,
          items: [
            { value: "TODO", text: "TODO" | statusLabel },
            { value: "IN_PROGRESS", text: "IN_PROGRESS" | statusLabel },
            { value: "DONE", text: "DONE" | statusLabel }
          ]
        }) }}

        <div class="govuk-button-group">
          {{ govukButton({ text: "Save status" }) }}
          <a href="/tasks/{{ task.id }}" class="govuk-link">Cancel</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}
